KERNEL_DIR ?= /lib/modules/$(shell uname -r)/build

include $(KERNEL_DIR)/include/config/auto.conf

KBUILD_ARGS := -C "$(KERNEL_DIR)" \
               M="$(CURDIR)"

@kontra_kbuild_toolchain@

# KBUILD_ARGUMENTS given at configure time are saved in this Makefile. Detached builds reuse them, and these saved
# values override variables with the same names passed on this wrapper's command line.
KONTRA_KBUILD_ARGUMENTS := @kontra_kbuild_arguments_text@

# Keep C++ COMDAT sections through Kbuild's relocatable module link. Disable module BTF because Linux's module BTF
# tooling does not support C++ DWARF. Kontraband always uses these values even if KBUILD_ARGUMENTS contains a conflict.
KONTRA_REQUIRED_KBUILD_ARGUMENTS := LDFLAGS_MODULE=--force-group-allocation \
                                    CONFIG_DEBUG_INFO_BTF_MODULES=

.PHONY: default modules modules_install clean

default: modules

# Kbuild can successfully check an up-to-date module without changing its timestamp. Touch it after that check so
# CMake's unchecked target stays up to date. Check that the module exists first so touch cannot create a missing one.
modules:
	+$(MAKE) $(KBUILD_ARGS) $(KONTRA_DERIVED_KBUILD_ARGUMENTS) $(KONTRA_KBUILD_ARGUMENTS) $(KONTRA_REQUIRED_KBUILD_ARGUMENTS) KONTRA_VALIDATE_LINKER=1 $@
	@test -f "$(CURDIR)/@kontra_module_name@.ko"
	@touch "$(CURDIR)/@kontra_module_name@.ko"

clean:
	+$(MAKE) $(KBUILD_ARGS) $(KONTRA_DERIVED_KBUILD_ARGUMENTS) $(KONTRA_KBUILD_ARGUMENTS) $(KONTRA_REQUIRED_KBUILD_ARGUMENTS) $@

modules_install:
	+$(MAKE) $(KBUILD_ARGS) $(KONTRA_DERIVED_KBUILD_ARGUMENTS) $(KONTRA_KBUILD_ARGUMENTS) $(KONTRA_REQUIRED_KBUILD_ARGUMENTS) $@
