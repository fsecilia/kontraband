# Generated by Kontraband. Do not edit.

@kontra_kbuild_compatibility@

@kontra_kbuild_linker@

obj-m += @kontra_module_name@.o

# Kontraband modules are always composite. Every source object is under projection/, components/, or generated/ and is
# listed in <module>-y.
@kontra_object_flag_lines_text@
# Do not pass Kbuild warnings meant only for C to the C++ compiler. Apply the same filtering to optional W= warnings.
conflicting_c_warnings := \
    bad-function-cast \
    designated-init \
    implicit-function-declaration \
    implicit-int \
    incompatible-pointer-types \
    missing-parameter-type \
    missing-prototypes \
    nested-externs \
    no-override-init \
    no-pointer-sign \
    no-unterminated-string-initialization \
    no-unused-const-variable \
    old-style-definition \
    strict-prototypes

# Build cxx_flags.
# Start with _c_flags rather than c_flags because c_flags also adds include settings meant only for C and forces
# compiler_types.h.
# ftrace metadata does not work safely with C++ functions emitted as COMDAT in more than one translation unit. Disable
# ftrace for C++ only; C and assembly keep Kbuild's normal tracing behavior.
conflicting_cxx_flags := \
    $(CC_FLAGS_FTRACE) \
    -DCC_USING_% \
    -std=% \
    $(addprefix -W, $(conflicting_c_warnings)) \
    $(addprefix -Werror=, $(conflicting_c_warnings))

filtered_cxx_flags = $(filter-out $(conflicting_cxx_flags), \
    $(_c_flags) \
    $(modkern_cflags) \
    $(basename_flags) \
    $(modname_flags))

kontra_cxx_baseline_flags := \
    -ffreestanding \
    -fno-builtin \
    -fno-exceptions \
    -fno-rtti \
    -fno-threadsafe-statics \
    -fno-use-cxa-atexit \
    -nostdlib

# x86-64 Kbuild disables x87 to catch floating-point code. Some freestanding C++ headers still need the ABI long double
# type, so allow x87 instructions during C++ compilation. This makes the type usable, but kernel C++ still must not do
# floating-point work.
kontra_cxx_compatibility_flags :=
ifeq ($(CONFIG_X86_64),y)
kontra_cxx_compatibility_flags += -m80387
endif

cxx_flags = $(filtered_cxx_flags) \
    $(kontra_cxx_baseline_flags) \
    $(kontra_cxx_compatibility_flags) \
    $(KONTRA_CXXFLAGS_$(target-stem).o)

quiet_cmd_cxx_o_cpp = CXX [M]  $@
cmd_cxx_o_cpp = $(CC) $(cxx_flags) -Wp,-MMD,$(depfile) -c -o $@ $< \
	$(cmd_objtool)

define rule_cxx_o_cpp
	$(call cmd_and_fixdep,cxx_o_cpp)
	$(call cmd,gen_objtooldep)
	$(call cmd,warn_shared_object)
endef

$(obj)/%.o: $(src)/%.cc FORCE
	$(call if_changed_rule,cxx_o_cpp)

$(obj)/%.o: $(src)/%.cpp FORCE
	$(call if_changed_rule,cxx_o_cpp)

$(obj)/%.o: $(src)/%.cxx FORCE
	$(call if_changed_rule,cxx_o_cpp)

@kontra_module_name@-y := @kontra_objects_text@
@kontra_user_kbuild_include@
